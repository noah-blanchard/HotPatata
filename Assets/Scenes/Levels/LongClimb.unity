  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'Two branches 26 m apart over the void: Moon throws through Sun''s hoop
    to drop his own drawbridge; Moon stands in the light to hold Sun''s gangway;
    Moon rides a shuttle longer than a fuse while Sun walks beside it, the bomb crossing
    both ways.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: branch to branch
    kind: 0
    from: {x: -11.8, y: 2.199997, z: 54}
    to: {x: 11.8, y: 2.199997, z: 54}
    via: []
  - name: the Moon drawbridge's gap
    kind: 0
    from: {x: 13, y: 1.699997, z: 23}
    to: {x: 13, y: 1.699997, z: 37}
    via: []
  - name: the Sun gangway's gap
    kind: 0
    from: {x: -13, y: 2.199997, z: 64}
