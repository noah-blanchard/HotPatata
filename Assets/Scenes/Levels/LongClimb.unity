  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'Out of sight: a rock wall in the mist splits the boardwalks (the receiver''s
    plate lights a beacon, the thrower lobs blind to it); then two roofed tunnels,
    a no-carry strip in each: the bomb crosses only by the chutes, each partner at
    the other''s pad. Each tunnel''s gate is opened by the winch in the other.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: boardwalk to boardwalk
