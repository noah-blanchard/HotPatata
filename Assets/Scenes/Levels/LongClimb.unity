  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'The crowns, on 4.5 s: Moon''s lever lowers Sun''s drawbridge, Sun''s winch
    lowers Moon''s; one throw through the two race hoops drops both last drawbridges
    to the lookout for 8 s; the bomb through the bell arch opens the cabin, the finish
    inside.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: Sun's drawbridge gap
    kind: 0
    from: {x: -9, y: 0, z: 11}
    to: {x: -9, y: 0, z: 25}
    via: []
  - name: Moon's drawbridge gap
    kind: 0
    from: {x: 9, y: 6, z: 49}
    to: {x: 9, y: 6, z: 63}
    via: []
