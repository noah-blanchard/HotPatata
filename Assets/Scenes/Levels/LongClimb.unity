    from: {x: 7, y: 8, z: 73.5}
    to: {x: 7, y: 9, z: 87.099976}
    via: []
  - name: crown to crown
    kind: 0
    from: {x: -10.5, y: 5, z: 39}
    to: {x: 8.5, y: 5, z: 39}
    via: []
  - name: the cabin door
