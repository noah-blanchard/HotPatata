  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'The crowns, on 4.5 s: Moon''s lever lowers Sun''s drawbridge, Sun''s winch
    lowers Moon''s; one throw through the two race hoops drops both last drawbridges
    to the lookout for 8 s; the bomb through the bell arch opens the cabin, the finish
    inside.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: Sun's drawbridge gap
    kind: 0
    from: {x: -9, y: 0, z: 11}
    to: {x: -9, y: 0, z: 25}
    via: []
  - name: Moon's drawbridge gap
    kind: 0
    from: {x: 9, y: 6, z: 49}
    to: {x: 9, y: 6, z: 63}
    via: []
  - name: pre-deck to the lookout (Sun)
    kind: 0
    from: {x: -9, y: 8, z: 73.5}
    to: {x: -9, y: 9, z: 87.099976}
    via: []
  - name: pre-deck to the lookout (Moon)
    kind: 0
    from: {x: 7, y: 8, z: 73.5}
    to: {x: 7, y: 9, z: 87.099976}
    via: []
  - name: crown to crown
    kind: 0
    from: {x: -10.5, y: 5, z: 39}
    to: {x: 8.5, y: 5, z: 39}
    via: []
  - name: the cabin door
    kind: 1
    from: {x: -1, y: 9, z: 92.79999}
    to: {x: -1, y: 12.5, z: 93.400024}
    via: []
