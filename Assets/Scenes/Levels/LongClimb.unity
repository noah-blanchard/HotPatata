  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'High and low: Sun rides the rafts on the river, Moon runs the catwalk 7
    m up the east wall; the bomb passes up and down. Sun''s winch on dock B opens
    Moon''s catwalk gate; Moon in the crack of light holds Sun''s portcullis; at
    the end Moon''s lever lifts Sun''s cage to the exit.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: the catwalk from a raft
    kind: 1
    from: {x: -1, y: -16.300001, z: 99}
    to: {x: 7.4, y: -9.5, z: 99}
    via: []
  - name: the exit landing from dock C
    kind: 1
    from: {x: 4.8, y: -16.6, z: 176}
    to: {x: 5.5, y: -9.5, z: 176}
    via: []
  - name: the portcullis
    kind: 1
    from: {x: -6, y: -16.6, z: 132}
    to: {x: -6, y: -12, z: 133}
    via: []
  - name: the catwalk gate
    kind: 1
    from: {x: 8.5, y: -9.5, z: 121.29999}
    to: {x: 8.5, y: -5.9, z: 122}
    via: []
  - name: raft 1 to dock B2
    kind: 0
    from: {x: -6, y: -16.6, z: 120.5}
    to: {x: -6, y: -16.6, z: 138}
    via: []
