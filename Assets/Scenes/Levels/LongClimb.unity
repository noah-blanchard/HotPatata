  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'The cliff, high and low across a 20 m ravine: Moon rides three cages up
    the west towers, Sun climbs two step relays on the east past a swinging log.
    Each of Moon''s cages rises from Sun''s winch; Sun''s last cage from Moon''s
    lever; Sun''s winch on top brings Moon''s last cage up. The bomb crosses the
    ravine all the way.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: across the ravine (first shelves)
    kind: 0
    from: {x: -12, y: 12, z: 26}
    to: {x: 8, y: 12, z: 26}
    via: []
  - name: the west tower from the shore
    kind: 1
    from: {x: -11, y: 0, z: 15}
    to: {x: -12.5, y: 12, z: 15}
    via: []
  - name: the west tower's middle
    kind: 1
    from: {x: -17, y: 12, z: 37}
    to: {x: -18.5, y: 24, z: 37}
    via: []
  - name: the west tower's top
    kind: 1
    from: {x: -21, y: 24, z: 47}
    to: {x: -22.5, y: 35.5, z: 47}
    via: []
  - name: the head wall
    kind: 1
    from: {x: 22, y: 24, z: 61}
    to: {x: 22, y: 35.5, z: 65.5}
    via: []
  - name: the ravine's back
    kind: 1
    from: {x: -2, y: -1.6999998, z: 55}
    to: {x: -2, y: 35.5, z: 57.5}
    via: []
