--- !u!114 &460284737
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 460284735}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'Out of sight: a rock wall in the mist splits the boardwalks (the receiver''s
    plate lights a beacon, the thrower lobs blind to it); then two roofed tunnels,
    a no-carry strip in each: the bomb crosses only by the chutes, each partner at
    the other''s pad. Each tunnel''s gate is opened by the winch in the other.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: boardwalk to boardwalk
    kind: 0
    from: {x: -17.8, y: 0, z: 64}
    to: {x: 6.8, y: 0, z: 64}
    via: []
  - name: the mist wall
    kind: 1
    from: {x: -18, y: 0, z: 64}
    to: {x: -13, y: 11.8, z: 64}
    via: []
  - name: the Sun tunnel gate
    kind: 1
    from: {x: -19, y: 0, z: 125}
    to: {x: -19, y: 4.4, z: 125.600006}
    via: []
  - name: the Moon tunnel gate
    kind: 1
    from: {x: 5, y: 0, z: 125}
    to: {x: 5, y: 4.4, z: 125.600006}
    via: []
