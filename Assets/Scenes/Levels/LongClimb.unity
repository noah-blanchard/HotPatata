  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'Two lanes split by a 7 m spine: Moon''s lever lowers Sun''s drawbridge
    over the stream, Sun''s winch raises Moon''s gate (each lane opened from the
    other); the bomb crosses the spine from lane to lane. Together again, a pass
    through the ring opens the mine for 9 s.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: the stream
    kind: 0
    from: {x: -8.35, y: 0, z: 61.2}
    to: {x: -8.35, y: 0, z: 76.8}
    via: []
  - name: the spine from the ledge
    kind: 1
    from: {x: 3.2, y: 3, z: 80}
    to: {x: 1.6, y: 7.2, z: 80}
    via: []
  - name: the spine from the stream bank
    kind: 1
    from: {x: -3.2, y: 0, z: 84}
    to: {x: -1.6, y: 7.2, z: 84}
    via: []
  - name: the Moon gate
    kind: 1
    from: {x: 8.35, y: 3, z: 93.4}
    to: {x: 8.35, y: 7.4, z: 94}
    via: []
  - name: the mine gate
    kind: 1
    from: {x: 0, y: 0, z: 132.4}
    to: {x: 0, y: 4.6, z: 133}
    via: []
  - name: the lane walls
    kind: 1
    from: {x: -13.5, y: 0, z: 70}
    to: {x: -15, y: 9, z: 70}
    via: []
