  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'The twin firs: one climbs each. Each cage rises from a winch on the other
    fir; at 50 m the braid swaps them (a stair from A''s arrival up to B''s departure
    crosses over a rope bridge from B''s arrival to A''s departure); each departure
    deck stands too high above its own arrival to climb. The bomb crosses between
    the firs all the way.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: fir to fir (first rings)
    kind: 0
    from: {x: -17.411398, y: 12, z: 33.961243}
    to: {x: -2.718091, y: 12, z: 34.04303}
    via: []
  - name: 'A: arrival to departure'
    kind: 1
    from: {x: -22.897907, y: 24, z: 38.405518}
    to: {x: -22.901596, y: 27.400002, z: 38.299805}
    via: []
  - name: 'B: arrival to departure'
    kind: 1
    from: {x: 3.077654, y: 24, z: 38.44507}
    to: {x: 3.0866528, y: 34.4, z: 37.987}
    via: []
  - name: 'A: first ring to arrival'
    kind: 1
    from: {x: -23.025959, y: 12, z: 29.246704}
    to: {x: -22.897907, y: 24, z: 29.413818}
    via: []
  - name: 'B: departure to the top ring'
    kind: 1
    from: {x: 3.0866528, y: 34.4, z: 37.987}
    to: {x: 3.0778017, y: 38.800003, z: 37.968323}
    via: []
