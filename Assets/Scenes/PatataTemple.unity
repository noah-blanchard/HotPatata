--- !u!114 &1764030606
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1764030604}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'The nave''s runner crosses the lasers and stands on the plate: the slab
    turns to join the west and east docks (twelve seconds). The pair boards its east
    end; let go, it turns back and carries them, passing, to the exit; the holder
    then walks the slab.'
  minPlayers: 3
  twoFail: 'With two: the plate is behind the lasers, where the bomb never goes,
    so the carrier waits at a dock and rides alone, far longer than a fuse.'
  shortcuts:
  - name: west dock to the exit
    kind: 0
    from: {x: -17.5, y: 0, z: 80}
    to: {x: -6, y: 0, z: 90.5}
    via: []
  - name: east dock to the exit
    kind: 0
    from: {x: 17.5, y: 0, z: 80}
    to: {x: 6, y: 0, z: 90.5}
    via: []
  - name: across the pit
    kind: 0
    from: {x: -17.5, y: 0, z: 74}
    to: {x: 17.5, y: 0, z: 74}
    via: []
  - name: over the west divide
    kind: 2
    from: {x: -8, y: 0, z: 40}
    to: {x: -4, y: 7, z: 40}
    via: []
  - name: over the east divide
    kind: 2
    from: {x: 0, y: 0, z: 40}
    to: {x: 4, y: 7, z: 40}
    via: []
