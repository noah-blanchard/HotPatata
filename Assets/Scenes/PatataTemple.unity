--- !u!114 &706108029
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 706108027}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'One per wing: each plate raises another wing''s herse (the nave''s the
    west''s, the east''s the nave''s, the west''s the east''s). Stand on all three,
    keep the bomb moving through the brambles (the one holding it lets their sand
    run), then let go together.'
  minPlayers: 3
  twoFail: 'With two: a plate is empty and its herse never rises; one runner cannot
    hold two plates (76 m apart round the divides, longer than the sand).'
  shortcuts:
  - name: over the west divide
    kind: 2
    from: {x: -8, y: 0, z: 30}
    to: {x: -4, y: 7, z: 30}
    via: []
  - name: over the east divide
    kind: 2
    from: {x: 0, y: 0, z: 30}
    to: {x: 4, y: 7, z: 30}
    via: []
  - name: west to nave
    kind: 3
    from: {x: -8, y: 0, z: 44}
    to: {x: 0, y: 0, z: 44}
    via:
    - {x: -8, y: 0, z: 10}
    - {x: 0, y: 0, z: 10}
  - name: nave to east
    kind: 3
    from: {x: 0, y: 0, z: 44}
    to: {x: 8, y: 0, z: 44}
    via:
    - {x: 0, y: 0, z: 10}
    - {x: 8, y: 0, z: 10}
  - name: east to west
    kind: 3
    from: {x: 8, y: 0, z: 44}
    to: {x: -8, y: 0, z: 44}
    via:
    - {x: 8, y: 0, z: 10}
    - {x: -8, y: 0, z: 10}
