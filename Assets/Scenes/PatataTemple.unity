  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'The west''s hourglass raises the nave''s bridge, the nave''s hourglass
    the east herse, the east''s light the west herse: hold, juggle the bomb through
    the brambles, then go, in the four seconds of sand.'
  minPlayers: 3
  twoFail: 'With two: one wing is empty and what it opens stays shut; one runner
    cannot hold the west and the nave plates (68 m apart round the divides).'
  shortcuts:
  - name: the nave gap
    kind: 0
    from: {x: 0, y: 0, z: 52}
    to: {x: 0, y: 0, z: 66}
    via: []
  - name: over the west divide
    kind: 2
    from: {x: -8, y: 0, z: 50}
    to: {x: -4, y: 7, z: 50}
    via: []
  - name: over the east divide
    kind: 2
    from: {x: 0, y: 0, z: 50}
    to: {x: 4, y: 7, z: 50}
    via: []
  - name: west to nave
    kind: 3
    from: {x: -8, y: 0, z: 40}
    to: {x: 0, y: 0, z: 40}
    via:
    - {x: -8, y: 0, z: 10}
    - {x: 0, y: 0, z: 10}
