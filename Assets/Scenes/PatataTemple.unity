  - name: the east gap
    kind: 0
    from: {x: 8, y: 0, z: 48}
    to: {x: 8, y: 0, z: 62}
    via: []
  - name: over the east divide
    kind: 2
    from: {x: 0, y: 0, z: 20}
    to: {x: 4, y: 7, z: 20}
    via: []
