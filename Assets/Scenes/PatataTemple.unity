  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'Two empty hands on the slab raise the bridge for all (four seconds of sand);
    then one stands in the light behind the lasers: the pivot turns to the docks,
    the pair boards its east end and, let go, it carries them to the altar; the arch,
    the beacon.'
  minPlayers: 3
  twoFail: 'With two: the slab needs two empty hands, and the light is behind lasers
    the bomb never crosses: the carrier would ride alone.'
  shortcuts:
  - name: the forecourt gap
    kind: 0
    from: {x: 0, y: 0, z: 30}
    to: {x: 0, y: 0, z: 44}
    via: []
  - name: west dock to the altar
    kind: 0
    from: {x: -17.5, y: 0, z: 96}
    to: {x: -6, y: 0, z: 104.5}
    via: []
  - name: east dock to the altar
    kind: 0
    from: {x: 17.5, y: 0, z: 96}
    to: {x: 6, y: 0, z: 104.5}
    via: []
