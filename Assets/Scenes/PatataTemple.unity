  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: One holds the plate beyond the west lasers, which raises the nave's herse;
    the thrower sends the bomb into a stone head and goes through; the third waits
    at that head's exit and passes the bomb to the thrower through the brambles.
  minPlayers: 3
  twoFail: 'With two: the plate''s holder is 26 m from the west exit and the thrower
    can only go through while it is held: nobody waits at an exit, and the lasers
    behind the herse stop the bomb carried through.'
  shortcuts:
  - name: over the nave wall
    kind: 2
    from: {x: 0, y: 0, z: 34}
    to: {x: 0, y: 7, z: 40}
    via: []
  - name: over the west divide
    kind: 2
    from: {x: -8, y: 0, z: 60}
    to: {x: -4, y: 7, z: 60}
    via: []
  - name: over the east divide
    kind: 2
    from: {x: 0, y: 0, z: 60}
    to: {x: 4, y: 7, z: 60}
    via: []
