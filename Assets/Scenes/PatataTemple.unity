  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'A rider on the shuttle cuts the sun beam over the chasm and the herse rises
    while the light is cut: the pair takes the bomb through then; the rider reaches
    the far ledge and joins them through the lasers.'
  minPlayers: 3
  twoFail: 'With two: the rider is the only one who can cut the beam, so the carrier
    goes through alone and waits longer than a fuse; riding together leaves the bomb
    on the far ledge, behind lasers it never crosses.'
  shortcuts:
  - name: the chasm
    kind: 0
    from: {x: -4, y: 0, z: 30}
    to: {x: -4, y: 0, z: 74.5}
    via: []
  - name: over the herse wall
    kind: 2
    from: {x: 4, y: 0, z: 24}
    to: {x: 4, y: 7, z: 30}
    via: []
  - name: over the divide
    kind: 2
    from: {x: -4, y: 0, z: 60}
    to: {x: 0, y: 7, z: 60}
    via: []
  - name: over the ledge end
    kind: 2
    from: {x: -4, y: 0, z: 78}
    to: {x: -4, y: 7, z: 82.5}
    via: []
