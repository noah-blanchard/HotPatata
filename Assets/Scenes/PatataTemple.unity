  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'The west runner crosses into the nave by the lasers; two empty hands on
    the slab raise the east bridge, five seconds more once they let go: they run
    through the east lasers and over with the carrier; then one pass through the
    arch.'
  minPlayers: 3
  twoFail: 'With two: the slab needs two empty hands and one of you always holds
    the bomb.'
  shortcuts:
  - name: the east gap
    kind: 0
    from: {x: 8, y: 0, z: 48}
    to: {x: 8, y: 0, z: 62}
    via: []
  - name: over the east divide
    kind: 2
    from: {x: 0, y: 0, z: 20}
    to: {x: 4, y: 7, z: 20}
    via: []
