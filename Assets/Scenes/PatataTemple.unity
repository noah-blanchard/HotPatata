  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: The holder in the shrine turns the slab to the east dock; the pair boards;
    let go, the slab turns back for twelve seconds and carries the pair, passing,
    into the enclosure; their throw through the ring raises the holder's bridge.
  minPlayers: 3
  twoFail: 'With two: the holder in the shrine is out of any throw, so the carrier
    rides alone for longer than a fuse (the enclosure''s door only meets the slab
    at the end), and nobody is across to throw through the ring.'
  shortcuts:
  - name: the south void
    kind: 0
    from: {x: 0, y: 0, z: 10}
    to: {x: 0, y: 0, z: 24}
    via: []
  - name: the ledge to the enclosure
    kind: 0
    from: {x: -21, y: 0, z: 64}
    to: {x: -6, y: 0, z: 64}
    via: []
  - name: the dock to the enclosure
    kind: 0
    from: {x: 17, y: 0, z: 46}
    to: {x: 6, y: 0, z: 56.5}
    via: []
  - name: over the enclosure
    kind: 2
    from: {x: 14, y: 0, z: 50}
    to: {x: 6.5, y: 7, z: 60}
    via: []
