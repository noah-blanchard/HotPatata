  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: One goes low (the south stair, the footbridge, the cage the other hoists
    from the south winch with empty hands); then the far winch (empty hands, an hourglass)
    lowers the drawbridge for the one left on the south rim. The bomb crosses by
    passes the whole way.
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: the ravine under the drawbridge
    kind: 0
    from: {x: -6, y: 2.3, z: 69.58335}
    to: {x: -6, y: 2.3, z: 85.58335}
    via: []
  - name: the ravine at the cage
    kind: 0
    from: {x: 12.8, y: 2, z: 70.47607}
    to: {x: 12.8, y: 2, z: 90.978294}
    via: []
  - name: the north wall over the ledge
    kind: 1
    from: {x: 15.8, y: -5, z: 88.89231}
    to: {x: 15.8, y: 2, z: 91.89231}
    via: []
