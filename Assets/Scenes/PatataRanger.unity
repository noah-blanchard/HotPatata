  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'A pass through the porch''s hoop raises the stairwell door for six seconds;
    the runner climbs behind the sparks while the carrier waits in the cold larder;
    the runner sees which chute comes out upstairs and calls it; the upper winch
    lifts the carrier''s cage. The house is roofed: nothing is lobbed in.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: over the house's south wall
    kind: 2
    from: {x: -26.96482, y: 27, z: 160.42955}
    to: {x: -30.264822, y: 35.850002, z: 166.12955}
    via: []
  - name: the ground floor to the upper floor
    kind: 1
    from: {x: -27.864822, y: 27, z: 170.62955}
    to: {x: -27.864822, y: 32.5, z: 170.62955}
    via: []
