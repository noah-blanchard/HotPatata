  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'Two cages, one each way: an empty-handed body on the counterweight lifts
    the first, the bomb is thrown down, then the winch above lifts the second. Then
    the hoops: the catcher reads the glyph on the balcony board, the thrower sends
    the bomb through that hoop; its bridge leads on, the others to dead ends.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: the trunk face from the lower terrace
    kind: 1
    from: {x: 11.081385, y: 11.5, z: 118.05351}
    to: {x: 11.11138, y: 19.5, z: 120.51276}
    via: []
  - name: the upper terrace to the owl landing
    kind: 0
    from: {x: 6.3776603, y: 19.5, z: 127.44961}
    to: {x: -3.123995, y: 19.5, z: 138.00226}
    via: []
