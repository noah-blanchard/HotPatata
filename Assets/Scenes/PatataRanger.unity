  m_Script: {fileID: 11500000, guid: 3d93f2edd868f1e438dd4ee97fe8cd0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: HotPatata::HotPatata.SectionContract
  force: 'The long bridge into the crowns under a swinging log, rotten planks, the
    twin fir''s winch bridge (empty hands hold its hourglass while the other crosses),
    then the race: a pass through the tower''s hoop lowers the lookout''s drawbridge
    for thirteen seconds, both run; the bomb through the bell arch, the team aboard.'
  minPlayers: 2
  twoFail: 
  shortcuts:
  - name: the twin fir to the signal tower
    kind: 0
    from: {x: 9.820259, y: 36, z: 208.74794}
    to: {x: 0.9547348, y: 36, z: 220.09529}
    via: []
  - name: the perch to the lookout
    kind: 0
    from: {x: 9.239971, y: 41, z: 238.48878}
    to: {x: -5.2800484, y: 44, z: 240.0149}
    via: []
