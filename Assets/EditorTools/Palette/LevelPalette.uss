.pal-root {
    flex-grow: 1;
}

.pal-toolbar {
    flex-shrink: 0;
}

.pal-search {
    flex-grow: 1;
    width: auto;
}

.pal-tabs {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.pal-tab {
    margin: 2px 1px;
    padding: 2px 8px;
    border-radius: 3px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.pal-tab--on {
    background-color: rgba(80, 140, 220, 0.45);
}

.pal-grid {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
}

.pal-section-items {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2px 4px 6px 4px;
}

.pal-section-items--list {
    flex-direction: column;
    flex-wrap: nowrap;
}

.pal-tile {
    width: 92px;
    height: 112px;
    margin: 3px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.3);
    background-color: rgba(255, 255, 255, 0.04);
    align-items: center;
}

.pal-tile:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

.pal-tile--armed {
    border-color: rgb(255, 200, 70);
    border-width: 2px;
}

.pal-tile-image {
    width: 84px;
    height: 84px;
    margin-top: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.pal-tile-label {
    font-size: 10px;
    white-space: normal;
    -unity-text-align: upper-center;
    padding: 0 2px;
}

.pal-row-item {
    flex-direction: row;
    height: 26px;
    align-items: center;
    padding: 0 4px;
    border-radius: 3px;
}

.pal-row-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.pal-row-item .pal-tile-image {
    width: 22px;
    height: 22px;
    margin: 0 6px 0 0;
}

.pal-row-item .pal-tile-label {
    font-size: 12px;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.pal-star {
    position: absolute;
    top: 1px;
    right: 1px;
    width: 18px;
    height: 18px;
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.35);
    font-size: 13px;
}

.pal-row-item .pal-star {
    position: relative;
}

.pal-star--on {
    color: rgb(255, 205, 60);
}

.pal-looks-badge {
    position: absolute;
    top: 2px;
    left: 3px;
    font-size: 9px;
    color: rgba(255, 255, 255, 0.6);
}

.pal-strip {
    flex-shrink: 0;
    padding: 4px 6px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
    background-color: rgba(0, 0, 0, 0.12);
}

.pal-strip-head {
    flex-direction: row;
    align-items: center;
}

.pal-armed {
    flex-grow: 1;
    -unity-font-style: bold;
    white-space: normal;
}

.pal-small {
    font-size: 10px;
}

.pal-chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.pal-chip {
    margin: 2px;
    padding: 1px 8px;
    border-radius: 9px;
    font-size: 11px;
}

.pal-chip--on {
    background-color: rgba(80, 140, 220, 0.6);
}

.pal-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.pal-snaps Toggle {
    margin-right: 8px;
}

.pal-snaps .unity-toggle__label {
    min-width: 0;
    margin-right: 2px;
}

.pal-snap-title {
    -unity-font-style: bold;
    margin-right: 6px;
}

.pal-hint {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.55);
    white-space: normal;
}

.pal-empty {
    padding: 12px;
    white-space: normal;
    color: rgba(255, 255, 255, 0.6);
}
