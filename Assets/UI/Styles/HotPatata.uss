/* HotPatata UI theme (ARCHITECTURE §6.2). Placeholder art direction: soft navy panels, warm white text, a sunny
   yellow focus ring that reads at a glance on keyboard and gamepad. Every screen builds on these hp-* classes. */

:root {
    --hp-ink: #F7F3EA;
    --hp-ink-dim: #C9C3D9;
    --hp-panel: rgba(20, 26, 46, 0.94);
    --hp-scrim: rgba(10, 14, 28, 0.55);
    --hp-button: #2F3B60;
    --hp-button-hover: #3D4C7A;
    --hp-button-active: #253050;
    --hp-secondary: #474258;
    --hp-accent: #FFCB3D;
    --hp-radius: 14px;
    -unity-font-style: normal;
    color: var(--hp-ink);
}

/* The stack fills the screen; each screen fills the stack. */
.hp-stack {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hp-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* A dimmed full-screen overlay that centres its panel. */
.hp-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--hp-scrim);
}

.hp-panel {
    min-width: 520px;
    max-width: 760px;
    padding: 32px 40px;
    border-radius: var(--hp-radius);
    background-color: var(--hp-panel);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
}

.hp-title {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--hp-ink);
    margin-bottom: 8px;
}

.hp-hint {
    font-size: 20px;
    color: var(--hp-ink-dim);
    white-space: normal;
    margin-bottom: 14px;
}

/* Buttons: big targets, a clear yellow ring when focused (keyboard / gamepad) or hovered. */
.hp-button {
    height: 60px;
    margin: 6px 0;
    padding: 0 24px;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--hp-ink);
    background-color: var(--hp-button);
    border-radius: var(--hp-radius);
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.08s;
}

.hp-button:hover {
    background-color: var(--hp-button-hover);
}

.hp-button:focus {
    border-color: var(--hp-accent);
    background-color: var(--hp-button-hover);
    scale: 1.03 1.03;
}

.hp-button:active {
    background-color: var(--hp-button-active);
    scale: 0.98 0.98;
}

.hp-button--secondary {
    background-color: var(--hp-secondary);
}

/* Fields (toggles, sliders): readable labels, the same focus ring. */
.hp-toggle,
.hp-slider {
    min-height: 52px;
    margin: 6px 0;
    padding: 4px 12px;
    border-radius: var(--hp-radius);
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    font-size: 22px;
}

.hp-toggle:focus,
.hp-slider:focus {
    border-color: var(--hp-accent);
}

.hp-toggle .unity-base-field__label,
.hp-slider .unity-base-field__label {
    color: var(--hp-ink);
    font-size: 22px;
    min-width: 220px;
}

.hp-button--danger {
    background-color: #7A2E3A;
}

.hp-button--danger:hover,
.hp-button--danger:focus {
    background-color: #95384A;
}

/* Settings (#17): a wide panel, a scrolling list of sections and rows, a footer with the buttons. */
.hp-panel--wide {
    width: 1040px;
    max-width: 92%;
    max-height: 90%;
}

.hp-scroll {
    flex-shrink: 1;
    max-height: 720px;
    margin-bottom: 12px;
}

.hp-section {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--hp-accent);
    margin: 18px 0 6px 4px;
}

.hp-row {
    flex-direction: row;
    align-items: center;
    min-height: 58px;
    margin: 3px 0;
    padding: 4px 16px;
    border-radius: var(--hp-radius);
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.04);
}

.hp-row:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.hp-row:focus {
    border-color: var(--hp-accent);
    background-color: rgba(255, 255, 255, 0.1);
}

.hp-row:disabled {
    opacity: 0.4;
}

.hp-row__label {
    width: 440px;
    font-size: 22px;
    color: var(--hp-ink);
    white-space: normal;
}

.hp-row__field {
    flex-grow: 1;
    margin: 0 12px;
}

.hp-row__value {
    width: 90px;
    font-size: 22px;
    -unity-text-align: middle-right;
    color: var(--hp-ink-dim);
}

.hp-row__toggle {
    flex-grow: 1;
    margin: 0 12px;
}

.hp-choice {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hp-choice__value {
    flex-grow: 1;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: var(--hp-ink);
}

.hp-choice__arrow {
    width: 44px;
    height: 40px;
    font-size: 26px;
    color: var(--hp-ink);
    background-color: var(--hp-button);
    border-radius: 10px;
    border-width: 0;
}

.hp-footer {
    flex-direction: row;
    justify-content: flex-end;
}

.hp-footer .hp-button {
    margin-left: 12px;
    min-width: 220px;
}

/* Main menu and lobby (#15): a compact column over the menu scene. */
.hp-overlay--menu {
    background-color: rgba(10, 14, 28, 0.35);
}

.hp-panel--menu {
    width: 680px;
    max-height: 96%;
    padding: 24px 36px;
}

.hp-panel--menu .hp-button {
    height: 50px;
    margin: 4px 0;
    font-size: 22px;
}

.hp-panel--menu .hp-row {
    min-height: 50px;
}

.hp-field {
    margin: 4px 0;
    min-height: 50px;
    padding: 2px 12px;
    border-radius: var(--hp-radius);
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.04);
    align-items: center;
}

.hp-field:focus {
    border-color: var(--hp-accent);
}

.hp-field .unity-base-field__label {
    min-width: 200px;
    font-size: 22px;
    color: var(--hp-ink);
}

.hp-field .unity-base-text-field__input {
    font-size: 22px;
    min-height: 38px;
    color: #10141F;
    background-color: var(--hp-ink);
    border-radius: 8px;
}

.hp-group {
    margin: 2px 0 2px 16px;
}

.hp-error {
    color: #FF8A7A;
    margin-top: 8px;
}

.hp-code {
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 8px;
    color: var(--hp-accent);
    margin: 0 0 8px 0;
}

.hp-player {
    font-size: 24px;
    color: var(--hp-ink);
    margin: 2px 0;
}
