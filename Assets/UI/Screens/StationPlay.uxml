<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hp="HotPatata" editor-extension-mode="False">
    <ui:VisualElement class="hp-board">
        <ui:VisualElement class="hp-panel hp-panel--board">
            <ui:Label text="LET'S PLAY" class="hp-title" />
            <ui:VisualElement name="actions" class="hp-v">
                <ui:VisualElement class="hp-row hp-row--field">
                    <ui:TextField name="name-field" label="Your name" class="hp-field hp-field--inline" />
                </ui:VisualElement>
                <ui:Button name="host-online" class="hp-button hp-button--big">
                    <ui:VisualElement class="hp-icon hp-icon--globe" />
                    <ui:VisualElement class="hp-button__text">
                        <ui:Label text="HOST ONLINE" class="hp-button__label" />
                        <ui:Label text="pick a level, get a game code" class="hp-button__sub" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:VisualElement class="hp-card">
                    <ui:Label text="GAME CODE" class="hp-label" />
                    <ui:VisualElement class="hp-h">
                        <hp:CodeDials name="code-dials" class="hp-grow" />
                        <ui:Button name="join-code" class="hp-button hp-button--secondary hp-button--join">
                            <ui:VisualElement class="hp-icon hp-icon--join" />
                            <ui:Label text="JOIN" class="hp-button__label" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="play-local" class="hp-button hp-button--secondary">
                    <ui:VisualElement class="hp-icon hp-icon--local" />
                    <ui:VisualElement class="hp-button__text">
                        <ui:Label text="PLAY LOCAL" class="hp-button__label" />
                        <ui:Label text="2 players, one keyboard" class="hp-button__sub" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:VisualElement class="hp-h">
                    <ui:Button name="settings" class="hp-button hp-button--neutral hp-button--small">
                        <ui:VisualElement class="hp-icon hp-icon--gear" />
                        <ui:Label text="SETTINGS" class="hp-button__label" />
                    </ui:Button>
                    <hp:ToggleRow name="direct-toggle" label="LAN / testing" class="hp-grow hp-row--compact" />
                </ui:VisualElement>
                <ui:VisualElement name="direct-group" class="hp-card">
                    <ui:VisualElement class="hp-h hp-h--end">
                        <ui:TextField name="direct-address" label="ADDRESS" class="hp-field hp-grow" />
                        <ui:Button name="join-ip" class="hp-button hp-button--neutral hp-button--small">
                            <ui:Label text="JOIN IP" class="hp-button__label" />
                        </ui:Button>
                        <ui:Button name="host-direct" class="hp-button hp-button--neutral hp-button--small">
                            <ui:Label text="HOST" class="hp-button__label" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="working" class="hp-note">
                <ui:VisualElement name="working-spinner" class="hp-potato hp-potato--small" />
                <ui:Label name="status" text="Connecting..." class="hp-note__text" />
            </ui:VisualElement>
            <ui:Label name="error" class="hp-error" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
