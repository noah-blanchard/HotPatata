<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="hp-overlay">
        <ui:VisualElement class="hp-panel hp-panel--small">
            <ui:Label name="title" text="PAUSED" class="hp-title hp-title--big hp-title--center" />
            <ui:Label name="hint" text="The game is paused." class="hp-hint hp-hint--center hp-hint--big" />
            <ui:VisualElement name="online-note" class="hp-note">
                <ui:VisualElement class="hp-icon hp-icon--info hp-icon--ink hp-icon--big" />
                <ui:Label text="The game keeps running for everyone. If you hold the bomb, its fuse still burns." class="hp-note__text" />
            </ui:VisualElement>
            <ui:Button name="resume" class="hp-button hp-button--big">
                <ui:VisualElement class="hp-icon hp-icon--play" />
                <ui:Label text="RESUME" class="hp-button__label" />
            </ui:Button>
            <ui:Button name="settings" class="hp-button hp-button--neutral">
                <ui:VisualElement class="hp-icon hp-icon--gear" />
                <ui:Label text="SETTINGS" class="hp-button__label" />
            </ui:Button>
            <ui:Button name="leave" class="hp-button hp-button--danger">
                <ui:VisualElement class="hp-icon hp-icon--door" />
                <ui:Label text="LEAVE TO MENU" class="hp-button__label" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
