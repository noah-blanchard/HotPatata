<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="hp-overlay hp-overlay--strong">
        <ui:VisualElement class="hp-panel hp-panel--dialog">
            <ui:VisualElement class="hp-dialog-disc">
                <ui:VisualElement class="hp-icon hp-icon--door" />
            </ui:VisualElement>
            <ui:Label name="title" text="Are you sure?" class="hp-title hp-title--dialog" />
            <ui:Label name="message" text="The question's details." class="hp-hint hp-hint--center hp-hint--big" />
            <ui:VisualElement class="hp-dialog-buttons">
                <ui:Button name="cancel" class="hp-button hp-button--secondary">
                    <ui:Label text="CANCEL" class="hp-button__label" />
                </ui:Button>
                <ui:Button name="confirm" class="hp-button hp-button--danger">
                    <ui:Label name="confirm-label" text="CONFIRM" class="hp-button__label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
